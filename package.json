{
  "name": "room-booking-api-zadanie-05",
  "version": "1.0.0",
  "private": true,
  "description": "Room Booking API with PostgreSQL, authentication, authorization and configuration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js --postgres",
    "start:memory": "node server.js --memory",
    "start:postgres": "node server.js --postgres",
    "knex": "knex --knexfile knexfile.js",
    "migrate:latest": "knex --knexfile knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.js migrate:rollback",
    "seed:run": "knex --knexfile knexfile.js seed:run",
    "double-booking": "node scripts/double-booking.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --runInBand --testPathPatterns=tests/unit",
    "test:integration": "jest --runInBand --testPathPatterns=tests/integration"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "supertest": "^7.1.4"
  }
}
