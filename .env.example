POSTGRES_USER=room_booking
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_DB=room_booking
DATABASE_URL=postgresql://room_booking:replace-with-local-database-password@127.0.0.1:5432/room_booking
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-local-admin-password
DEMO_USER_PASSWORD=replace-with-local-user-password
NODE_ENV=development
STORAGE=postgres
PORT=3000
API_URL=http://localhost:3000
DEMO_ROOM_ID=1
DEBUG=
DISABLE_APP_OVERLAP_CHECK=0
