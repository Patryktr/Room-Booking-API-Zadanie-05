{
  "openapi": "3.0.3",
  "info": {
    "title": "Room Booking API",
    "version": "4.0.0",
    "description": "Room Booking API: authentication, JWT, role/ownership authorization, configuration and PostgreSQL."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    }
  ],
  "tags": [
    {
      "name": "Buildings",
      "description": "Budynki i sale"
    },
    {
      "name": "Rooms",
      "description": "Sale konferencyjne"
    },
    {
      "name": "Reservations",
      "description": "Rezerwacje sal"
    },
    {
      "name": "Debug",
      "description": "Endpoint demonstracyjny błędu 500"
    },
    {
      "name": "Authentication",
      "description": "Registration, login and current-user profile"
    }
  ],
  "paths": {
    "/api/rooms": {
      "get": {
        "tags": ["Rooms"],
        "summary": "Pobierz wszystkie sale",
        "responses": {
          "200": {
            "description": "Lista sal",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Room"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": ["Rooms"],
        "summary": "Dodaj salę do budynku",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewRoom"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sala utworzona",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Room"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/rooms/{id}": {
      "get": {
        "tags": ["Rooms"],
        "summary": "Pobierz salę po ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "1"
          }
        ],
        "responses": {
          "200": {
            "description": "Sala",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Room"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/reservations": {
      "get": {
        "tags": ["Reservations"],
        "summary": "Rezerwacje z filtrami i paginacją",
        "parameters": [
          {
            "name": "roomId",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "buildingId",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["CONFIRMED", "CANCELLED"]
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "startTime",
                "-startTime",
                "createdAt",
                "-createdAt",
                "participants",
                "-participants"
              ],
              "default": "startTime"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "description": "ADMIN only; USER is always scoped to own records.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dane i metadane",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "tags": ["Reservations"],
        "summary": "Utwórz rezerwację",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewReservation"
              },
              "example": {
                "roomId": 1,
                "participants": 20,
                "startTime": "2026-11-10T10:00:00+01:00",
                "endTime": "2026-11-10T12:00:00+01:00"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Rezerwacja utworzona; daty zwracane w UTC",
            "headers": {
              "Location": {
                "description": "Adres utworzonej rezerwacji",
                "schema": {
                  "type": "string",
                  "example": "/api/reservations/2"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/reservations/{id}/cancel": {
      "patch": {
        "tags": ["Reservations"],
        "summary": "Anuluj przyszłą rezerwację",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "2"
          }
        ],
        "responses": {
          "200": {
            "description": "Anulowana rezerwacja; ponowne anulowanie jest idempotentne",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/debug/crash": {
      "get": {
        "tags": ["Debug"],
        "summary": "Wywołaj kontrolowany błąd 500 (do demonstracji)",
        "responses": {
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/buildings": {
      "get": {
        "tags": ["Buildings"],
        "summary": "Pobierz budynki wraz z liczbą sal",
        "responses": {
          "200": {
            "description": "Lista budynków",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BuildingWithCount"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": ["Buildings"],
        "summary": "Dodaj budynek",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewBuilding"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Budynek utworzony",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Building"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/buildings/{id}": {
      "get": {
        "tags": ["Buildings"],
        "summary": "Pobierz budynek",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Budynek",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Building"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/buildings/{id}/rooms": {
      "get": {
        "tags": ["Buildings"],
        "summary": "Pobierz sale budynku",
        "description": "Budynek bez sal zwraca pustą tablicę.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sale budynku",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Room"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/reservations/{id}": {
      "get": {
        "tags": ["Reservations"],
        "summary": "Pobierz rezerwację z salą i budynkiem",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rezerwacja z relacjami",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a USER account",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created; password hash is not returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login and issue a JWT",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HS256 bearer access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get authenticated account",
        "responses": {
          "200": {
            "description": "Current user without password hash",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Room": {
        "type": "object",
        "required": ["id", "name", "capacity", "building"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "capacity": {
            "type": "integer"
          },
          "building": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          }
        }
      },
      "NewReservation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roomId", "participants", "startTime", "endTime"],
        "properties": {
          "roomId": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "participants": {
            "type": "integer",
            "minimum": 1,
            "example": 20
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-10T10:00:00+01:00"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-10T12:00:00+01:00"
          }
        }
      },
      "Reservation": {
        "type": "object",
        "required": [
          "id",
          "roomId",
          "participants",
          "startTime",
          "endTime",
          "status",
          "createdAt",
          "cancelledAt",
          "user"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 2
          },
          "roomId": {
            "type": "integer",
            "example": 1
          },
          "participants": {
            "type": "integer",
            "example": 20
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-10T09:00:00.000Z"
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-10T11:00:00.000Z"
          },
          "status": {
            "type": "string",
            "enum": ["CONFIRMED", "CANCELLED"],
            "example": "CONFIRMED"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "room": {
            "type": "object",
            "required": ["id", "name", "building"],
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "building": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "user": {
            "$ref": "#/components/schemas/ReservationUser"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "location": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "Building": {
        "type": "object",
        "required": ["id", "name", "address"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      },
      "BuildingWithCount": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Building"
          },
          {
            "type": "object",
            "required": ["roomsCount"],
            "properties": {
              "roomsCount": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        ]
      },
      "NewBuilding": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "address"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "address": {
            "type": "string",
            "minLength": 3,
            "maxLength": 240
          }
        }
      },
      "NewRoom": {
        "type": "object",
        "additionalProperties": false,
        "required": ["buildingId", "name", "capacity"],
        "properties": {
          "buildingId": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ReservationPage": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reservation"
            }
          },
          "meta": {
            "type": "object",
            "required": ["page", "limit", "total", "totalPages"],
            "properties": {
              "page": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "totalPages": {
                "type": "integer"
              }
            }
          }
        }
      },
      "RegisterBody": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "jan.kowalski@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 72,
            "format": "password"
          }
        }
      },
      "LoginBody": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "format": "password"
          }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "email", "role", "createdAt"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": ["USER", "ADMIN"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["accessToken", "tokenType", "expiresIn"],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": ["Bearer"]
          },
          "expiresIn": {
            "type": "string",
            "example": "15m"
          }
        }
      },
      "ReservationUser": {
        "type": "object",
        "required": ["id", "email"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Niepoprawne dane; details zawiera wszystkie błędy walidacji",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "VALIDATION_ERROR",
                "message": "Validation failed",
                "details": [
                  {
                    "location": "body",
                    "field": "participants",
                    "message": "Too small: expected number to be >0"
                  }
                ],
                "requestId": "03fda03c-5345-4689-b866-a6902d7da099"
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Nie znaleziono sali lub rezerwacji",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Konflikt reguły biznesowej",
        "content": {
          "application/json": {
            "schema": {
